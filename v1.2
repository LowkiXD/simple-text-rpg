function showChoices(options) {
  let choicesDiv = document.getElementById("choices"); //creates a var in js which refers the html div tag
  choicesDiv.innerHTML = ""; // prints nothing on the div, but will be used once the buttons are made
  options.forEach(opt => { //foreach loop
    let btn = document.createElement("button"); // for each choices made, create a button
    btn.innerText = opt.text; // text labeled in the button
    btn.onclick = opt.action; // on click, calls this function/action
    choicesDiv.appendChild(btn); // add the button in the div
  })
};

